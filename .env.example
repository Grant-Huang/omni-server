# Copy to .env and fill in. See docs/mvp-plan.md section 2.2 -- single server-side
# key for the MVP, not per-user/BYOK yet.

QWEN_API_KEY=
# Workspace ID (format llm-xxxxxxxxxxxxxxxx), NOT your account UID -- see
# https://help.aliyun.com/zh/model-studio/obtain-the-app-id-and-workspace-id.
# Prefer setting this: the dedicated domain it selects is what fixed the
# session.update hangs on the shared domain (docs/design-risks-review.md 3.2).
QWEN_WORKSPACE_ID=
QWEN_WS_BASE=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_MODEL=qwen3.5-omni-flash-realtime
QWEN_VOICE=Serena
QWEN_TEXT_MODEL=qwen-turbo

HOST=127.0.0.1
PORT=8766

# Comma-separated list of allowed origins for the frontend's cross-origin requests
# (docs/mvp-plan.md section 2.3). "*" is fine for local dev; set explicit origins
# before deploying anywhere reachable from outside your own machine.
CORS_ORIGINS=*

MEMORY_DATA_PATH=./data/memory.json
